#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

CERTS := /usr/share/ca-certificates

all: $(OBJ)/.built

$(OBJ)/.built: $(SRCROOT)/mozilla/certdata.txt $(SRCROOT)/mozilla/blacklist.txt $(SRCROOT)/mozilla/certdata2pem.py debian/rules
	@python3 -I -c 'import cryptography' 2>/dev/null || \
		{ echo "ca-certificates: certdata2pem.py needs python3-cryptography on the build host" >&2; exit 1; }
	rm -rf $(OBJ)
	mkdir -p $(OBJ)/mozilla
	cp $(SRCROOT)/mozilla/certdata.txt $(SRCROOT)/mozilla/blacklist.txt $(OBJ)/mozilla/
	cd $(OBJ)/mozilla && python3 -I -W ignore::DeprecationWarning \
		$(SRCROOT)/mozilla/certdata2pem.py > ../certdata2pem.log
	rm $(OBJ)/mozilla/certdata.txt $(OBJ)/mozilla/blacklist.txt
	@sed -n 's/^\(Trusted but expired\|UNTRUSTED\|Found duplicate\)/ca-certificates: warning: &/p' \
		$(OBJ)/certdata2pem.log
	cd $(OBJ)/mozilla && printf '%s\n' *.crt | LC_ALL=C sort | \
		while IFS= read -r f; do cat "$$f"; done > ../ca-certificates.crt
	touch $@

check: $(OBJ)/.built
	python3 -I $(SRCROOT)/debian/check.py $(SRCROOT)/mozilla/certdata.txt $(SRCROOT)/mozilla/blacklist.txt \
		$(OBJ)/ca-certificates.crt $(OBJ)/mozilla

install: all check
	rm -rf $(ROOT)$(CERTS)
	install -d $(ROOT)$(CERTS)/mozilla $(ROOT)/etc/ssl/certs
	install -m 644 $(OBJ)/mozilla/*.crt $(ROOT)$(CERTS)/mozilla/
	install -m 644 $(OBJ)/ca-certificates.crt $(ROOT)$(CERTS)/
	ln -sfn $(CERTS)/ca-certificates.crt $(ROOT)/etc/ssl/certs/ca-certificates.crt
	ln -sfn /etc/ssl/certs/ca-certificates.crt $(ROOT)/etc/ssl/cert.pem

.PHONY: all check install
